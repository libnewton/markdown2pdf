#!/usr/bin/env python3
"""md2pdf — Markdown -> PDF or HTML via the @local/md2pdf Typst package.

All Markdown processing lives in the Typst package. This script only does the
host I/O Typst's compile sandbox cannot do itself: it discovers remote image
URLs (pass 1), fetches them, and renders (pass 2). It contains no Markdown
logic.

Standard library only, Python 3.9+, no behaviour that differs per OS.

    md2pdf [--pdf] [--html] <input.md> [output]
    md2pdf [--pdf] [--html] [-o OUTDIR] <input.md> [<input.md> ...]
"""

import argparse
import http.client
import ipaddress
import json
import re
import secrets
import shutil
import signal
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

MIN_TYPST = (0, 15)

# Stands in for an image that could not be fetched, so one bad URL degrades to
# a blank box instead of failing the whole render.
PLACEHOLDER = b'<svg xmlns="http://www.w3.org/2000/svg" width="1" height="1"></svg>'

# The document is rendered from a file written next to it, so that `read()` and
# `image()` resolve against the document's own directory rather than the
# package root. `asset` and `read-asset` are the same trick for images the
# template places itself (header/footer, cover logo) and for the HTML target,
# which embeds every image as a data: URI. Remote images are aliased under the
# per-run directory `md2pdf-remote-dir`, so concurrent runs never share a path.
# While `md2pdf-fetched` is 0 the downloads do not exist yet, and HTML's
# discovery run reads a blank image in their place.
MAIN_TEMPLATE = """#import "@local/md2pdf:0.1.0": prepare, prepare-html
#let _src = read("{docname}")
#let _html = sys.inputs.at("md2pdf-target", default: "") == "html"
#let _html-theme = sys.inputs.at("md2pdf-html-theme", default: "system")
#let _remote-dir = sys.inputs.at("md2pdf-remote-dir", default: "remote")
#let _fetched = sys.inputs.at("md2pdf-fetched", default: "1") == "1"
#let _read-asset(p) = if not _fetched and p.starts-with(_remote-dir + "/") {{
  bytes("{blank}")
}} else {{
  read(p, encoding: none)
}}
#let _missing = json(bytes(sys.inputs.at("md2pdf-missing-images", default: "[]")))
#let _d = prepare(
  _src,
  asset: (p, ..a) => image(p, ..a),
  remote-dir: _remote-dir,
  missing-images: _missing,
)
#metadata(_d.remotes) <md2pdf-remote-images>
#metadata(_d.images) <md2pdf-images>
#metadata(_d.unknown-cites) <md2pdf-unknown-cites>
#if _html [
  #metadata(prepare-html(
    _src,
    read-asset: _read-asset,
    theme: _html-theme,
    remote-dir: _remote-dir,
    missing-images: _missing,
  )) <md2pdf-html>
] else if not _d.skip {{
  show: _d.template
  eval(_d.body, mode: "markup", scope: _d.scope)
}}
"""

EVAL_REMOTES = "query(<md2pdf-remote-images>).first().value"
EVAL_IMAGES = "query(<md2pdf-images>).first().value"
EVAL_CITES = "query(<md2pdf-unknown-cites>).first().value"
EVAL_HTML = "query(<md2pdf-html>).first().value"
EVAL_MANIFEST = "(remotes: %s, images: %s, cites: %s)" % (EVAL_REMOTES, EVAL_IMAGES, EVAL_CITES)
EVAL_BOTH = "(remotes: %s, images: %s, cites: %s, html: %s)" % (
    EVAL_REMOTES,
    EVAL_IMAGES,
    EVAL_CITES,
    EVAL_HTML,
)

MARKDOWN_SUFFIXES = (".md", ".markdown", ".mdown", ".mkd")


class RenderError(Exception):
    """One file failed; the rest of a batch carries on."""


def die(message):
    print("md2pdf: " + message, file=sys.stderr)
    raise SystemExit(1)


def warn(message):
    print("md2pdf: WARN " + message, file=sys.stderr)


def status(message):
    # stderr, so `--html in.md /dev/stdout` leaves stdout as pure HTML.
    print("md2pdf: " + message, file=sys.stderr)


# ---------------------------------------------------------------------------
# Typst
# ---------------------------------------------------------------------------


def find_typst():
    """The `typst` binary, checked for a new enough version.

    `shutil.which` picks up `typst.exe` on Windows without special-casing.
    """
    exe = shutil.which("typst")
    if not exe:
        die("`typst` not found on PATH — install Typst %d.%d or newer" % MIN_TYPST)
    try:
        out = subprocess.run(
            [exe, "--version"], capture_output=True, text=True, check=True
        ).stdout
    except (OSError, subprocess.CalledProcessError) as e:
        die("could not run `typst --version`: %s" % e)
    # "typst 0.15.1 (9dfd3a08)"
    parts = out.split()
    version = (0, 0)
    if len(parts) >= 2:
        try:
            nums = parts[1].split(".")
            version = (int(nums[0]), int(nums[1]))
        except (ValueError, IndexError):
            pass
    if version < MIN_TYPST:
        die(
            "Typst %d.%d or newer required (found %s) — the HTML target needs "
            "`typst eval`" % (MIN_TYPST[0], MIN_TYPST[1], out.strip() or "unknown")
        )
    return exe


def typst_base(docdir, fonts, system_fonts=True):
    """Typst's shared flags.

    System fonts are consulted by default so a document in Chinese, Japanese
    or Korean can use a face the machine already has — `fonts/` carries Latin
    only, and a CJK face is ~8 MB per weight. `--no-system-fonts` restores the
    hermetic behaviour when byte-identical output across machines matters more.
    """
    flags = ["--root", str(docdir), "--font-path", str(fonts)]
    if not system_fonts:
        flags.append("--ignore-system-fonts")
    return flags


def input_flags(inputs):
    flags = []
    for key, value in inputs.items():
        flags += ["--input", "%s=%s" % (key, value)]
    return flags


def without_font_warnings(stderr):
    """Typst's stderr minus its "unknown font family" warnings.

    The templates list CJK fallbacks the bundled `fonts/` does not carry, so
    every run would otherwise print a screenful about faces nobody asked for.
    """
    blocks = re.split(r"(?m)^(?=(?:warning|error): )", stderr)
    kept = [b for b in blocks if not b.startswith("warning: unknown font family")]
    return "".join(kept).strip()


def typst_eval(exe, expression, main, docdir, fonts, inputs, system_fonts=True):
    """Evaluate an expression in the document's context and parse the result.

    Replaces the `typst query --field value` of the old shell shim, which Typst
    0.15 deprecates.
    """
    cmd = [exe, "eval", expression, "--in", str(main), "--format", "json"]
    cmd += typst_base(docdir, fonts, system_fonts) + input_flags(inputs)
    done = subprocess.run(cmd, capture_output=True, text=True)
    if done.returncode != 0:
        return None, without_font_warnings(done.stderr)
    try:
        return json.loads(done.stdout), None
    except json.JSONDecodeError as e:
        return None, str(e)


# ---------------------------------------------------------------------------
# Remote images
# ---------------------------------------------------------------------------


class SafeRedirect(urllib.request.HTTPRedirectHandler):
    """Follow redirects only while they stay http(s) and pass the host check.

    urllib follows redirects by default with no scheme check at all, so without
    this a remote server could bounce a fetch to `file:///etc/passwd` or to an
    address the host policy rejects.
    """

    max_repeats = 5
    max_redirections = 5

    def __init__(self, allow_private):
        self.allow_private = allow_private

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        check_url(newurl, self.allow_private)
        return urllib.request.HTTPRedirectHandler.redirect_request(
            self, req, fp, code, msg, headers, newurl
        )


def check_url(url, allow_private):
    """Reject anything that is not a plain http(s) fetch of a public host.

    The address check is best-effort: it resolves the name and inspects the
    answers, so a server that re-resolves to a private address between this
    check and the connection could still slip through. Closing that needs
    connection-level pinning, which urllib does not expose.
    """
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in ("http", "https"):
        raise ValueError("refusing %s: only http and https are fetched" % parsed.scheme)
    host = parsed.hostname
    if not host:
        raise ValueError("no host in URL")
    if allow_private:
        return
    try:
        infos = socket.getaddrinfo(host, parsed.port or (443 if parsed.scheme == "https" else 80))
    except socket.gaierror as e:
        raise ValueError("cannot resolve %s: %s" % (host, e))
    for info in infos:
        addr = ipaddress.ip_address(info[4][0])
        if (
            addr.is_private
            or addr.is_loopback
            or addr.is_link_local
            or addr.is_reserved
            or addr.is_multicast
        ):
            raise ValueError(
                "refusing %s: resolves to the non-public address %s "
                "(use --allow-private-hosts to permit it)" % (host, addr)
            )


def is_markup_page(head, content_type):
    """Whether a response is clearly a web page rather than an image.

    A soft-404 answers 200 with an HTML page, which would otherwise fail the
    whole render with "unknown image format". Anything not clearly markup is
    left to Typst, whatever its format.
    """
    if content_type.lower().startswith("text/html"):
        return True
    text = head.lstrip(b"\xef\xbb\xbf \t\r\n").lower()
    return text.startswith(b"<") and not text.startswith((b"<svg", b"<?xml", b"<!--"))


def fetch(url, dest, timeout, max_bytes, allow_private):
    """Download one image within `timeout` seconds in total.

    Streams, so an oversized body is cut off early. The deadline is checked
    between reads, so a slow drip overruns it by at most one socket timeout.
    """
    check_url(url, allow_private)
    deadline = time.monotonic() + timeout
    opener = urllib.request.build_opener(SafeRedirect(allow_private))
    request = urllib.request.Request(url, headers={"User-Agent": "md2pdf"})
    body = bytearray()
    with opener.open(request, timeout=timeout) as response:
        while True:
            chunk = response.read1(64 * 1024)
            if not chunk:
                break
            body += chunk
            if len(body) > max_bytes:
                raise ValueError(
                    "larger than the %d MB limit" % (max_bytes // (1024 * 1024))
                )
            if time.monotonic() > deadline:
                raise ValueError("timed out after %g s" % timeout)
        content_type = response.headers.get("Content-Type", "")
    if is_markup_page(bytes(body[:2048]), content_type):
        raise ValueError("not an image")
    dest.write_bytes(body)


def fetch_all(items, into, args):
    """Fetch every distinct remote image into `into`, keyed by its alias.

    Nothing is cached between runs: a shared cache keyed by a hash of the URL
    would let one document read another's downloads, since the alias is
    derivable from the URL alone.
    """
    seen = {}
    for item in items:
        url, alias = item.get("url"), item.get("alias")
        if not url or not alias:
            continue
        name = Path(alias).name
        if url in seen:
            # Same image twice in one document — link the second alias at the
            # bytes already on disk rather than fetching again.
            if seen[url] != name:
                shutil.copyfile(into / seen[url], into / name)
            continue
        try:
            fetch(url, into / name, args.timeout, args.max_size * 1024 * 1024, args.allow_private_hosts)
            seen[url] = name
            status("fetched %s" % url)
        except (
            urllib.error.URLError,
            http.client.HTTPException,
            ValueError,
            OSError,
        ) as e:
            (into / name).write_bytes(PLACEHOLDER)
            warn("could not fetch %s: %s" % (url, e))


# ---------------------------------------------------------------------------


def split_output(paths):
    """Separate the output from the inputs in `md2pdf in.md out.pdf`.

    Exactly two paths mean "input, output" unless the second is another
    Markdown file, in which case both are inputs. The one exception is the
    input named twice, which stays an output so that it can be refused.
    """
    if len(paths) == 2:
        first, second = paths
        other_markdown = (
            second.suffix.lower() in MARKDOWN_SUFFIXES
            and second.resolve() != first.resolve()
        )
        if not other_markdown:
            return paths[:1], second
    return paths, None


def parse_args(argv):
    p = argparse.ArgumentParser(
        prog="md2pdf",
        usage=(
            "md2pdf [options] input.md [output]\n"
            "       md2pdf [options] [-o OUTDIR] input.md [input.md ...]\n"
            "       md2pdf mcp [--root DIR]"
        ),
        description="Render Markdown to PDF or to one self-contained HTML file.",
        epilog=(
            "With one input, `output` names the file; its extension picks the format "
            "unless --pdf or --html is given. With several inputs or -o, every file "
            "is written to OUTDIR (default: next to its input) as <name>.pdf and/or "
            "<name>.html; --pdf --html writes both. A file that fails is reported and "
            "the rest still render; the exit status is 1 if any failed."
        ),
    )
    p.add_argument("paths", type=Path, nargs="+", help=argparse.SUPPRESS)
    p.add_argument("--output-file", type=Path, help=argparse.SUPPRESS)
    p.add_argument("--pdf", action="store_true", help="write PDF (the default)")
    p.add_argument("--html", action="store_true", help="write a standalone HTML file")
    p.add_argument(
        "-o", "--outdir", type=Path, metavar="OUTDIR",
        help="directory for the results, created if missing",
    )
    p.add_argument(
        "--timeout", type=float, default=20.0, metavar="SEC",
        help="total time allowed per remote image, default 20",
    )
    p.add_argument(
        "--max-size", type=int, default=32, metavar="MB",
        help="reject a remote image larger than this, default 32",
    )
    p.add_argument(
        "--allow-private-hosts", action="store_true",
        help="permit remote images on private or link-local addresses",
    )
    p.add_argument(
        "--no-system-fonts", dest="system_fonts", action="store_false",
        help="use only the bundled fonts, for output that cannot vary by machine",
    )
    p.add_argument(
        "--html-theme", choices=("system", "light", "dark"), default="system",
        help="initial standalone HTML theme, default system",
    )
    args = p.parse_args(argv)

    if args.output_file:
        args.inputs, args.output = args.paths, args.output_file
    elif args.outdir:
        args.inputs, args.output = args.paths, None
    else:
        args.inputs, args.output = split_output(args.paths)
    for source in args.inputs:
        if not source.is_file():
            p.error("no such file: %s" % source)
    if args.output and len(args.inputs) != 1:
        p.error("an output file takes exactly one input")

    args.formats = [f for f in ("pdf", "html") if getattr(args, f)]
    if args.output:
        if len(args.formats) > 1:
            p.error("an output file takes one of --pdf or --html, not both")
        if not args.formats:
            # Without an explicit flag the output extension picks the format.
            html = args.output.suffix.lower() in (".html", ".htm")
            args.formats = ["html" if html else "pdf"]
    elif not args.formats:
        args.formats = ["pdf"]
    return args


def jobs(args):
    """Every (input, output, format) the invocation asks for."""
    for source in args.inputs:
        for fmt in args.formats:
            output = args.output or (args.outdir or source.parent) / (
                "%s.%s" % (source.stem, fmt)
            )
            yield source, output, fmt


MCP_VERSION = "2026-07-28"
MCP_LEGACY_VERSION = "2025-06-18"
MCP_INFO = {"name": "md2pdf", "version": "0.1.0"}
MCP_INSTRUCTIONS = (
    "md2pdf extends CommonMark with preserved source line breaks, width-marked tables, "
    "admonitions, layout blocks, spoilers, math, Mermaid, page controls, citations, "
    "custom heading anchors, and YAML frontmatter. Read md2pdf://syntax before editing "
    "a document, then use render_file on a file below the configured root."
)


def mcp_result(request_id, result, modern=False):
    if modern:
        result.setdefault("resultType", "complete")
        result.setdefault("_meta", {})["io.modelcontextprotocol/serverInfo"] = MCP_INFO
    return {"jsonrpc": "2.0", "id": request_id, "result": result}


def mcp_error(request_id, code, message, modern=False):
    response = {
        "jsonrpc": "2.0",
        "id": request_id,
        "error": {"code": code, "message": message},
    }
    if modern:
        response["error"]["data"] = {
            "_meta": {"io.modelcontextprotocol/serverInfo": MCP_INFO}
        }
    return response


def mcp_cache(result, modern):
    if modern:
        result.update({"ttlMs": 3600000, "cacheScope": "public"})
    return result


def mcp_tools():
    return [
        {
            "name": "render_file",
            "description": (
                "Render an existing md2pdf Markdown file to PDF or standalone HTML. "
                "Read md2pdf://syntax before authoring: md2pdf syntax intentionally "
                "differs from ordinary Markdown. The output file is overwritten if it exists."
            ),
            "inputSchema": {
                "type": "object",
                "properties": {
                    "input_path": {"type": "string", "description": "Markdown path below the server root."},
                    "output_path": {"type": "string", "description": "Optional output path below the server root."},
                    "format": {"type": "string", "enum": ["pdf", "html"]},
                    "html_theme": {
                        "type": "string",
                        "enum": ["system", "light", "dark"],
                        "default": "system",
                    },
                },
                "required": ["input_path"],
                "additionalProperties": False,
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "output_path": {"type": "string"},
                    "format": {"type": "string"},
                    "mime_type": {"type": "string"},
                    "warnings": {"type": "array", "items": {"type": "string"}},
                },
                "required": ["output_path", "format", "mime_type", "warnings"],
            },
        }
    ]


def mcp_path(root, value, must_exist=False):
    path = Path(value)
    if not path.is_absolute():
        path = root / path
    path = path.resolve(strict=must_exist)
    if path != root and root not in path.parents:
        raise ValueError("path is outside the configured root")
    return path


def mcp_check_arguments(arguments):
    if not isinstance(arguments, dict):
        raise TypeError("arguments must be an object")
    for name in ("input_path", "output_path", "format", "html_theme"):
        if arguments.get(name) is not None and not isinstance(arguments[name], str):
            raise TypeError("%s must be a string" % name)


def mcp_render(root, arguments):
    source = mcp_path(root, arguments.get("input_path", ""), must_exist=True)
    if not source.is_file():
        raise ValueError("input_path is not a file")
    output_value = arguments.get("output_path")
    fmt = arguments.get("format")
    if fmt not in (None, "pdf", "html"):
        raise ValueError("format must be pdf or html")
    if fmt is None and output_value:
        fmt = "html" if Path(output_value).suffix.lower() in (".html", ".htm") else "pdf"
    fmt = fmt or "pdf"
    output = mcp_path(root, output_value or str(source.with_suffix("." + fmt)))
    if output == source:
        raise ValueError("input and output paths must differ")
    theme = arguments.get("html_theme", "system")
    if theme not in ("system", "light", "dark"):
        raise ValueError("html_theme must be system, light, or dark")

    cmd = [sys.executable, str(Path(__file__).resolve())]
    cmd.append("--html" if fmt == "html" else "--pdf")
    if fmt == "html":
        cmd.extend(["--html-theme", theme])
    cmd.extend(["--output-file", str(output), str(source)])
    done = subprocess.run(cmd, capture_output=True, text=True)
    if done.returncode != 0:
        message = done.stderr.strip() or done.stdout.strip() or "render failed"
        raise RuntimeError(message)
    warnings = [
        line.split("WARN ", 1)[1]
        for line in done.stderr.splitlines()
        if "WARN " in line
    ]
    mime = "text/html" if fmt == "html" else "application/pdf"
    return {
        "output_path": str(output),
        "format": fmt,
        "mime_type": mime,
        "warnings": warnings,
    }


def mcp_dispatch(message, root, modern):
    """Answer one JSON-RPC message; a notification (no id) gets no answer."""
    if not isinstance(message, dict):
        return mcp_error(None, -32600, "invalid request", modern), modern
    response, modern = mcp_handle(message, root, modern)
    return (response if "id" in message else None), modern


def mcp_handle(message, root, modern):
    request_id = message.get("id")
    method = message.get("method")
    params = message.get("params") or {}
    if not isinstance(params, dict):
        return mcp_error(request_id, -32602, "params must be an object", modern), modern
    if method == "server/discover":
        result = {
            "supportedVersions": [MCP_VERSION],
            "capabilities": {"tools": {}, "resources": {}},
            "instructions": MCP_INSTRUCTIONS,
            "ttlMs": 3600000,
            "cacheScope": "public",
        }
        return mcp_result(request_id, result, True), True
    if method == "initialize":
        result = {
            "protocolVersion": params.get("protocolVersion", MCP_LEGACY_VERSION),
            "capabilities": {"tools": {}, "resources": {}},
            "serverInfo": MCP_INFO,
            "instructions": MCP_INSTRUCTIONS,
        }
        return mcp_result(request_id, result), False
    if method in ("notifications/initialized", "notifications/cancelled"):
        return None, modern
    if method == "ping":
        return mcp_result(request_id, {}, modern), modern
    if method == "tools/list":
        return mcp_result(request_id, mcp_cache({"tools": mcp_tools()}, modern), modern), modern
    if method == "resources/list":
        resources = [
            {
                "uri": "md2pdf://syntax",
                "name": "md2pdf syntax reference",
                "description": "Complete authoring syntax and frontmatter reference.",
                "mimeType": "text/markdown",
            },
            {
                "uri": "md2pdf://example",
                "name": "md2pdf feature example",
                "description": "A document demonstrating every supported feature.",
                "mimeType": "text/markdown",
            },
        ]
        return mcp_result(
            request_id,
            mcp_cache({"resources": resources}, modern),
            modern,
        ), modern
    if method == "resources/read":
        uri = params.get("uri")
        if not isinstance(uri, str):
            return mcp_error(request_id, -32602, "uri must be a string", modern), modern
        paths = {
            "md2pdf://syntax": Path(__file__).resolve().parent.parent / "docs" / "SYNTAX.md",
            "md2pdf://example": Path(__file__).resolve().parent.parent / "tests" / "extended.md",
        }
        if uri not in paths:
            return mcp_error(request_id, -32602, "unknown resource", modern), modern
        try:
            text_value = paths[uri].read_text(encoding="utf-8")
        except OSError as error:
            detail = "cannot read %s: %s" % (uri, error.strerror)
            return mcp_error(request_id, -32002, detail, modern), modern
        result = {"contents": [{"uri": uri, "mimeType": "text/markdown", "text": text_value}]}
        return mcp_result(request_id, mcp_cache(result, modern), modern), modern
    if method == "tools/call":
        if params.get("name") != "render_file":
            return mcp_error(request_id, -32602, "unknown tool", modern), modern
        arguments = params.get("arguments")
        try:
            mcp_check_arguments({} if arguments is None else arguments)
        except TypeError as error:
            return mcp_error(request_id, -32602, str(error), modern), modern
        try:
            rendered = mcp_render(root, arguments or {})
            result = {
                "content": [{"type": "text", "text": json.dumps(rendered, ensure_ascii=False)}],
                "structuredContent": rendered,
                "isError": False,
            }
        except (OSError, ValueError, RuntimeError) as error:
            result = {
                "content": [{"type": "text", "text": str(error)}],
                "isError": True,
            }
        return mcp_result(request_id, result, modern), modern
    return mcp_error(request_id, -32601, "method not found", modern), modern


def mcp_main(argv):
    parser = argparse.ArgumentParser(prog="md2pdf mcp", description="Run the local md2pdf MCP server.")
    parser.add_argument("--root", type=Path, default=Path.cwd())
    args = parser.parse_args(argv)
    root = args.root.resolve(strict=True)
    if not root.is_dir():
        parser.error("--root must be a directory")
    modern = False
    for line in sys.stdin:
        try:
            message = json.loads(line)
            response, modern = mcp_dispatch(message, root, modern)
        except json.JSONDecodeError as error:
            response = mcp_error(None, -32700, str(error), modern)
        if response is not None:
            sys.stdout.write(json.dumps(response, ensure_ascii=False, separators=(",", ":")) + "\n")
            sys.stdout.flush()
    return 0


def typst_string(value):
    return value.replace("\\", "\\\\").replace('"', '\\"')


def render_file(exe, fonts, args, source, output, fmt):
    """Render one document, raising RenderError with a one-line cause."""
    source_path = source.resolve()
    if output.resolve() == source_path:
        raise RenderError("refusing to overwrite the input with its own output")
    docdir = source_path.parent
    try:
        output.parent.mkdir(parents=True, exist_ok=True)
    except OSError as e:
        raise RenderError("cannot create %s: %s" % (output.parent, e.strerror))

    # Everything this run puts next to the document shares one unique prefix,
    # so concurrent runs in one folder never touch each other's files.
    prefix = ".md2pdf-" + secrets.token_hex(4)
    main_typ = docdir / (prefix + ".typ")
    source_copy = docdir / (prefix + ".md")
    remote_dir = prefix + "-remote"
    base = {"md2pdf-remote-dir": remote_dir}

    def html_inputs():
        return dict(
            base,
            **{"md2pdf-query": "1", "md2pdf-target": "html", "md2pdf-html-theme": args.html_theme},
        )

    def evaluate(expression, inputs):
        return typst_eval(exe, expression, main_typ, docdir, fonts, inputs, args.system_fonts)

    try:
        docname = source.name
        try:
            # Typst refuses a backslash in any path, so such a file is read
            # through a copy.
            if "\\" in docname:
                shutil.copyfile(source_path, source_copy)
                docname = source_copy.name
            main_typ.write_text(
                MAIN_TEMPLATE.format(
                    docname=typst_string(docname),
                    blank=typst_string(PLACEHOLDER.decode()),
                ),
                encoding="utf-8",
            )
        except OSError as e:
            raise RenderError("cannot write in %s: %s" % (docdir, e.strerror))

        # Remote images cannot be fetched from inside Typst's sandbox, and a
        # missing local image would abort the compile, so the first run
        # discovers both. For HTML the same run already renders the document,
        # which is the whole job when there is nothing to fetch or stand in for.
        html = manifest = None
        if fmt == "html":
            manifest, _ = evaluate(EVAL_BOTH, dict(html_inputs(), **{"md2pdf-fetched": "0"}))
            html = manifest and manifest["html"]
        if manifest is None:
            manifest, _ = evaluate(EVAL_MANIFEST, dict(base, **{"md2pdf-query": "1"}))
        remotes, images, cites = (
            (manifest["remotes"], manifest["images"], manifest["cites"]) if manifest else ([], [], [])
        )
        for key in cites:
            warn("unknown citation key %s in %s" % (key, source))
        missing = [i for i in images if not (docdir / i.lstrip("/")).is_file()]
        for image in missing:
            warn("missing image %s in %s" % (image, source))
        if missing:
            base["md2pdf-missing-images"] = json.dumps(missing)
        if remotes or missing:
            html = None
        if remotes:
            fetch_dir = docdir / remote_dir
            fetch_dir.mkdir()
            fetch_all(remotes, fetch_dir, args)

        if fmt == "html":
            if html is None:
                html, err = evaluate(EVAL_HTML, html_inputs())
                if err or not isinstance(html, str):
                    raise RenderError("HTML render failed:\n%s" % (err or "unexpected result"))
            # newline="" keeps Windows from rewriting the engine's line endings.
            with open(output, "w", encoding="utf-8", newline="") as out:
                out.write(html)
        else:
            cmd = [exe, "compile", "--format", "pdf"]
            cmd += typst_base(docdir, fonts, args.system_fonts) + input_flags(base)
            cmd += [str(main_typ), str(output)]
            done = subprocess.run(cmd, capture_output=True, text=True)
            diagnostics = without_font_warnings(done.stderr)
            if done.returncode != 0:
                raise RenderError("PDF render failed:\n%s" % diagnostics)
            if diagnostics:
                print(diagnostics, file=sys.stderr)
    except OSError as e:
        raise RenderError("%s: %s" % (e.filename or output, e.strerror))
    finally:
        main_typ.unlink(missing_ok=True)
        source_copy.unlink(missing_ok=True)
        shutil.rmtree(str(docdir / remote_dir), ignore_errors=True)


def main(argv=None):
    raw = sys.argv[1:] if argv is None else argv
    if raw and raw[0] == "mcp":
        return mcp_main(raw[1:])
    args = parse_args(raw)
    exe = find_typst()
    # Run the `finally` cleanup the way Ctrl-C already does.
    signal.signal(signal.SIGTERM, lambda signum, frame: sys.exit(128 + signum))

    # `Path.resolve()` walks the symlink chain, so the fonts are found even when
    # the script is reached through a link on PATH.
    fonts = Path(__file__).resolve().parent.parent / "fonts"
    written = {}
    failed = False
    for source, output, fmt in jobs(args):
        try:
            if written.setdefault(output.resolve(), source) != source:
                raise RenderError(
                    "%s is also the output of %s" % (output, written[output.resolve()])
                )
            render_file(exe, fonts, args, source, output, fmt)
            status("wrote %s" % output)
        except RenderError as e:
            print("md2pdf: %s: %s" % (source, e), file=sys.stderr)
            failed = True
    return 1 if failed else 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)

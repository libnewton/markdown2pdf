#!/bin/sh
# md2pdf — host shim. Markdown -> PDF or HTML via the @local/md2pdf package.
#
# All Markdown processing lives in the Typst package. This shim only does host
# I/O: Typst's compile sandbox cannot reach the network, so remote images are
# discovered (pass 1: `typst query`), prefetched, then the document is
# rendered (pass 2). The shim contains no Markdown logic.
set -e

usage() {
  echo "usage: md2pdf [--html|--pdf] <input.md> [output]" >&2
  exit 1
}

format=""
input=""
output=""
for arg in "$@"; do
  case "$arg" in
    --html) format=html ;;
    --pdf) format=pdf ;;
    -h|--help) usage ;;
    -*) echo "md2pdf: unknown option $arg" >&2; usage ;;
    *) if [ -z "$input" ]; then input="$arg"; else output="$arg"; fi ;;
  esac
done
[ -n "$input" ] && [ -f "$input" ] || usage

# Without an explicit flag the output extension picks the format.
if [ -z "$format" ]; then
  case "$output" in
    *.html|*.htm) format=html ;;
    *) format=pdf ;;
  esac
fi
[ -n "$output" ] || output="${input%.*}.$format"

# `readlink -f` is GNU-only, so walk the symlink chain by hand: the shim is
# usually reached through a symlink on PATH, and the fonts sit next to the real
# script, not next to the link.
prog="$0"
while [ -L "$prog" ]; do
  target=$(readlink "$prog")
  case "$target" in
    /*) prog="$target" ;;
    *) prog="$(dirname "$prog")/$target" ;;
  esac
done
here=$(cd "$(dirname "$prog")" && pwd)
fonts="$here/../fonts"
docdir=$(cd "$(dirname "$input")" && pwd)
docname=$(basename "$input")
main="$docdir/.md2pdf-main-$$.typ"

# Remote images live in a per-user temp cache, not in the document's directory.
# Typst's sandbox only reads below --root, but it follows symlinks out of it, so
# the cache is linked in under the `remote/` prefix the engine emits.
cache="${TMPDIR:-/tmp}/md2pdf-cache-$(id -u)"
manifest="$cache/remotes-$$.json"
mkdir -p "$cache"
chmod 700 "$cache"
link="$docdir/remote"
if [ -e "$link" ] && [ ! -L "$link" ]; then
  echo "md2pdf: $link is in the way — delete it (remote images now go to $cache)" >&2
  exit 1
fi
ln -sfn "$cache" "$link"
trap 'rm -f "$main" "$manifest" "$link"' EXIT

# The eval happens here, in the document's directory, so image() paths in the
# generated body resolve against the document root (not the package). `asset`
# is the same trick for images the template itself places (header/footer, cover
# logo): the image() call has to live in this file to resolve correctly.
# `read-asset` is the same trick as `asset`, for the HTML target: the engine
# embeds every image as a data: URI, and only a read() written in this file
# resolves against the document root.
cat > "$main" <<EOF
#import "@local/md2pdf:0.1.0": prepare, prepare-html
#let _src = read("$docname")
#let _html = sys.inputs.at("md2pdf-target", default: "") == "html"
#let _d = prepare(_src, asset: (p, ..a) => image(p, ..a))
#metadata(_d.remotes) <md2pdf-remote-images>
#if _html [
  #metadata(prepare-html(_src, read-asset: p => read(p, encoding: none))) <md2pdf-html>
] else if not _d.skip {
  show: _d.template
  eval(_d.body, mode: "markup", scope: _d.scope)
}
EOF

# Pass 1 — discover remote image URLs (published as <md2pdf-remote-images>).
typst query --root "$docdir" --font-path "$fonts" --ignore-system-fonts \
  --input md2pdf-query=1 --one --field value \
  "$main" '<md2pdf-remote-images>' > "$manifest" 2>/dev/null || echo '[]' > "$manifest"

# Prefetch each remote image into <cache>/<hash>; Typst resolves it through the
# `remote/` symlink. Hashed by URL, so a second run reuses the download.
python3 - "$manifest" "$cache" <<'PY'
import json, os, sys, urllib.request
manifest, cache = sys.argv[1], sys.argv[2]
# Stands in for an image that could not be fetched, so one bad URL does not fail
# the whole compile. Never counts as a cache hit.
PLACEHOLDER = b'<svg xmlns="http://www.w3.org/2000/svg" width="1" height="1"></svg>'
try:
    items = json.load(open(manifest))
except Exception:
    items = []
for it in items:
    url, alias = it.get("url"), it.get("alias")
    if not url or not alias:
        continue
    dest = os.path.join(cache, os.path.basename(alias))
    if os.path.exists(dest) and open(dest, "rb").read() != PLACEHOLDER:
        continue
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "md2pdf"})
        with urllib.request.urlopen(req, timeout=20) as r:
            open(dest, "wb").write(r.read())
        print(f"md2pdf: fetched {url}")
    except Exception as e:
        open(dest, "wb").write(PLACEHOLDER)
        print(f"md2pdf: WARN could not fetch {url}: {e}", file=sys.stderr)
PY

# Pass 2 — render. HTML comes back as a Typst metadata value rather than a
# compiled artifact, so the same engine call serves the CLI and the browser.
if [ "$format" = html ]; then
  html="$cache/html-$$.json"
  trap 'rm -f "$main" "$manifest" "$link" "$html"' EXIT
  # `md2pdf-query=1` short-circuits prepare(), so the PDF body is never built.
  typst query --root "$docdir" --font-path "$fonts" --ignore-system-fonts \
    --input md2pdf-query=1 --input md2pdf-target=html --one --field value \
    "$main" '<md2pdf-html>' > "$html"
  python3 -c 'import json,sys
sys.stdout.write(json.load(open(sys.argv[1])))' "$html" > "$output"
else
  typst compile --root "$docdir" --font-path "$fonts" --ignore-system-fonts \
    "$main" "$output"
fi
echo "md2pdf: wrote $output"
